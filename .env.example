# cowallet v2 真机测试环境变量模板
#
# 复制为 .env 后填写本机值：cp .env.example .env
# .env 已被 git 忽略。不要把真实 API Key、助记词、私钥、Token 提交到仓库。

# ---------------------------------------------------------------------------
# Midscene 视觉模型（豆包 / 火山方舟，OpenAI 兼容协议）
# ---------------------------------------------------------------------------
MIDSCENE_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME="doubao-seed-2-1-turbo-260628"
MIDSCENE_MODEL_FAMILY="doubao-seed"
# 单步多轮重规划上限，遇到复杂长流程可以调大
MIDSCENE_REPLANNING_CYCLE_LIMIT=200

# ---------------------------------------------------------------------------
# 被测 App
# ---------------------------------------------------------------------------
ANDROID_BUNDLE_ID=com.cowallet.app
IOS_BUNDLE_ID=com.cowallet.app

# ---------------------------------------------------------------------------
# Android 真机
# ---------------------------------------------------------------------------
# 只连一台设备时可以留空，doctor 会要求目标设备唯一；连了多台就必须固定 serial。
# ANDROID_DEVICE_ID=R5CW41SNFGH
ADB_BIN=adb
ADB_HOST=127.0.0.1
ADB_PORT=5037

# ---------------------------------------------------------------------------
# iOS 真机 + WebDriverAgent
# ---------------------------------------------------------------------------
# 必填：xcrun devicectl list devices 里那台已连接 iPhone 的 identifier
IOS_UDID=
IOS_DEVICE_NAME=iPhone

# 必填：给 WebDriverAgentRunner 签名用的 Apple Developer Team ID
WDA_DEVELOPMENT_TEAM=

APPIUM_SERVER=http://127.0.0.1:4723
WDA_HOST=127.0.0.1
IOS_WDA_LOCAL_PORT=8100
WDA_REMOTE_PORT=8100
# WDA 脚本会顺带用 iproxy 做 USB 端口转发
WDA_START_IPROXY=true
WDA_STATUS_URL=http://127.0.0.1:8100/status
WDA_READY_TIMEOUT_SECONDS=180
# Smoke 脚本在 WDA 未就绪时是否自动构建/启动 WDA；false 则直接报错并提示手动启动
WDA_AUTOSTART=true
WDA_DERIVED_DATA_PATH=/private/tmp/midscene-wda-derived-data
WDA_PROJECT_PATH=node_modules/appium-webdriveragent/WebDriverAgent.xcodeproj
WDA_SCHEME=WebDriverAgentRunner
WDA_BUNDLE_ID=com.facebook.WebDriverAgentRunner.xctrunner

IOS_WDA_LAUNCH_TIMEOUT=300000
IOS_WDA_CONNECTION_TIMEOUT=300000
IOS_NO_RESET=false
IOS_FULL_RESET=false
IOS_NEW_COMMAND_TIMEOUT=300
IOS_SHOW_XCODE_LOG=true

# ---------------------------------------------------------------------------
# 测试账号 / 回归数据（按需填写，不要写真实助记词或私钥）
# ---------------------------------------------------------------------------
# TEST_NEW_USER_EMAIL=
# TEST_RECOVERY_EMAIL=
# TEST_WALLET_PASSWORD=

# ---------------------------------------------------------------------------
# 高风险动作门禁：默认全部关闭，需要当次明确授权才可打开
# ---------------------------------------------------------------------------
# 真实转账/兑换等不可逆动作，默认停在确认页
MANUAL_CONFIRM_REAL_TRANSFER=false
# 单笔测试转账的美元上限，0 表示不允许任何真实资金动作
MAX_TEST_TRANSFER_USD=0
# 允许的真实转账收款地址白名单（仅当次授权使用）
TEST_SAFE_EVM_RECEIVER=
